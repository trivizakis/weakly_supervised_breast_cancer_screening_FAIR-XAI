# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Model Checkpoints & Large Weights (strictly excluded)
*.pth
*.pt
*.tar
*.bin
*.h5
*.ckpt
checkpoints/
*/checkpoints/
**/checkpoints/**

# Heavy Raw Data & Offline Augmented Caches
*.npy
*.npz
*.dcm
*.dicom
augmented_cache/
preprocessed_cache/
cache/
data/

# Temporary & IDE files
.venv/
venv/
ENV/
.idea/
.vscode/
*.swp
*.tmp*
.DS_Store
